# Copy to .env and fill in. config.yaml refers to these as ${NAME}; this file never leaves your machine.
# Only fill in what you use.

TZ=Europe/London

# UniFi: a local "View Only" admin account
UNIFI_USER=homelab-map
UNIFI_PASS=

# Proxmox: an API token with the PVEAuditor role (read-only)
PROXMOX_TOKEN_ID=homelab-map@pve!map
PROXMOX_TOKEN_SECRET=

# BookStack: API token of a user allowed to edit the map page
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=

# Alerts (optional)
GOTIFY_TOKEN=
